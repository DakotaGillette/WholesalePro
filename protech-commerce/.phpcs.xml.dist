<?xml version="1.0"?>
<ruleset name="Protech Wholesale">
	<description>WordPress coding standards for the Protech Wholesale plugin.</description>

	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="6.0"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- Files are named class-{kebab-case-of-ClassName}.php (class-application-form.php),
		     which the sniff's class-applicationform.php expectation doesn't recognise. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="protech"/>
				<element value="ProtechWholesale"/>
				<element value="PROTECH_WHOLESALE"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="protech-wholesale"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<!-- Test files use PHPUnit's camelCase method names and helper classes freely. -->
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
</ruleset>
