# Copy this file to .env (repo root) and fill in real values there.
# .env is git-ignored — never commit real credentials or staging URLs.
# Used by bin/deploy.sh to deploy protech-commerce/ to Cloudways staging.

# Cloudways application-level SSH access, jailed to one staging app.
CW_SSH_HOST=00.000.000.000
CW_SSH_USER=your_app_ssh_username
CW_APP_PATH=applications/your_app_folder/public_html
CW_STAGING_URL=https://your-staging-domain.example.com

# Auth: set exactly ONE of these two.
# Key-based (preferred if your Cloudways app has an SSH key set up):
CW_SSH_KEY=~/.ssh/protech_staging
# Password-based (Cloudways "Application Credentials" SFTP login) —
# requires the `sshpass` CLI to be installed locally:
#CW_SSH_PASSWORD=your_sftp_password
